<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF5742D6" android:endColor="#FF8D74FF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF6755F6" android:endColor="#FF8C74FF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</selector>
