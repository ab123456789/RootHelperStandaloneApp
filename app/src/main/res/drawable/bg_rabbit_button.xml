<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rabbit_primary" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/rabbit_primary_dark" />
            <padding android:left="18dp" android:top="14dp" android:right="18dp" android:bottom="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/rabbit_primary_soft"
                android:endColor="@color/rabbit_accent_soft" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/rabbit_primary" />
            <padding android:left="18dp" android:top="14dp" android:right="18dp" android:bottom="14dp" />
        </shape>
    </item>
</selector>
