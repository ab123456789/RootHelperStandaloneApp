<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rabbit_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rabbit_panel"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="cm"
                android:textColor="@color/rabbit_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/desc_roothelper"
                android:textColor="@color/rabbit_text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rabbit_status"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingTop="10dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/status_ready"
                    android:textColor="@color/rabbit_success"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/textCdpStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rabbit_status_idle"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingTop="10dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="10dp"
                    android:text="CDP 未连接"
                    android:textColor="@color/rabbit_text_muted"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rabbit_panel"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_rabbit_button_primary"
                android:elevation="3dp"
                android:text="@string/btn_start_service"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEdge"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rabbit_button"
                android:elevation="1dp"
                android:text="@string/btn_open_edge_cdp"
                android:textAllCaps="false"
                android:textColor="@color/rabbit_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnId"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rabbit_button"
                android:elevation="1dp"
                android:text="@string/btn_run_id"
                android:textAllCaps="false"
                android:textColor="@color/rabbit_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPing"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rabbit_button"
                android:elevation="1dp"
                android:text="@string/btn_ping"
                android:textAllCaps="false"
                android:textColor="@color/rabbit_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBoot"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rabbit_button"
                android:elevation="1dp"
                android:text="@string/btn_toggle_boot"
                android:textAllCaps="false"
                android:textColor="@color/rabbit_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rabbit_button"
                android:elevation="1dp"
                android:text="@string/btn_stop_service"
                android:textAllCaps="false"
                android:textColor="@color/rabbit_danger"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rabbit_panel"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_output"
                android:textColor="@color/rabbit_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_output_desc"
                android:textColor="@color/rabbit_text_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rabbit_log"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:lineSpacingExtra="3dp"
                android:minHeight="280dp"
                android:padding="16dp"
                android:textColor="@color/rabbit_log_text"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
